---
import { Icon } from 'astro-icon/components'

import Link from '@/components/ui/Link.astro'
import { ROUTES } from '@/config/routes'
import { cn } from '@/lib/utils/cn'

import PortraitCircles from './PortraitCircles.astro'

const sectionId = 'hero'
---

<section
  aria-labelledby={sectionId}
  class="grid h-[calc(100svh-var(--header-h))] items-center"
>
  <div class="@container -mt-(--header-h)">
    <PortraitCircles className="mb-8" />
    <p class={cn('mb-3 text-lg')}>Hi 👋, my name is</p>
    <h1
      id={sectionId}
      class={cn(
        'block text-4xl leading-[140%] font-bold',
        '@xl:text-5xl',
        '@2xl:text-6xl',
      )}
    >
      Marek Honzal
    </h1>
    <h2
      class={cn(
        'text-base-content/60 text-2xl leading-[140%] font-bold tracking-wide',
        '@md:text-3xl',
        '@xl:text-4xl',
      )}
    >
      <span class="tagline-underline motion-safe:animate-underline-sweep">
        I build the parts of frontend you don't see
      </span>
    </h2>
    <p
      class={cn(
        'text-base-content/75 mt-6 leading-loose',
        '@lg:text-base',
        '@2xl:text-lg',
      )}
    >
      A frontend-focused software engineer drawn to architecture, state, and developer
      experience.
    </p>
    <p class={cn('text-base-content/75 leading-loose', '@lg:text-base', '@2xl:text-lg')}>
      At{' '}
      <Link hasIcon={false} href="https://apify.com/">
        Apify
      </Link>
      , I'm a Senior Engineer shaping the public web toward world-class.
    </p>
    <div
      class={cn(
        'mt-12 flex flex-col items-start gap-6',
        '@xl:mt-12 @xl:flex-row @xl:items-center @xl:gap-10',
      )}
    >
      <a
        href={ROUTES.blog._}
        class={cn('btn btn-primary group', '@xl:btn-lg')}
        data-astro-prefetch
      >
        Read the Blog{' '}
        <Icon
          name="lucide:arrow-right"
          class={cn(
            'ease-springy size-[1.25em] transition-transform duration-300',
            'motion-safe:group-hover:translate-x-1.25',
            'motion-safe:group-focus-visible:translate-x-1.25',
          )}
        />
      </a>
      <a
        href={ROUTES.projects._}
        class={cn('btn btn-neutral', '@xl:btn-lg')}
        data-astro-prefetch
      >
        See What I'm Building
      </a>
    </div>
  </div>
</section>
