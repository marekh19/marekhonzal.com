---
import { getCollection } from 'astro:content'

import ArticleGrid from '@/components/Content/ArticleGrid.astro'
import ButtonArrow from '@/components/ui/ButtonArrow.astro'
import { ROUTES } from '@/config/routes'
import { cn } from '@/lib/utils/cn'
import { getFeaturedSectionContent, shouldIncludeItem } from '@/lib/utils/content'

type Props = {
  className?: string
}

const { className } = Astro.props

const sectionId = 'blog'

const blogPosts = await getCollection('blog', shouldIncludeItem)
const featuredPosts = getFeaturedSectionContent(blogPosts)
---

<section
  aria-labelledby={sectionId}
  class={cn(
    'grid grid-cols-1',
    'md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-x-6',
    className,
  )}
>
  <h2
    id={sectionId}
    class={cn('mb-3 scroll-mt-8 text-3xl leading-[140%] font-semibold', 'md:text-4xl')}
  >
    Latest Thoughts
  </h2>
  <p class="mb-5 text-lg md:col-span-2">
    A mix of learnings, ideas, and reflections from both dev life and beyond.
  </p>
  <ArticleGrid posts={featuredPosts} className="md:col-span-2" />
  <a
    class={cn(
      'text-primary group inline-flex items-center gap-1.5 text-lg font-semibold',
      'link-outline link-outline-rounded mt-8 justify-self-start',
      'md:col-start-2 md:row-start-1 md:mt-0 md:justify-self-end',
    )}
    href={ROUTES.blog._}
    data-astro-prefetch
  >
    Read all posts <ButtonArrow />
  </a>
</section>
