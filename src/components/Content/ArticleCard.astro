---
import { Icon } from 'astro-icon/components'

import Thumbnail from '@/components/Content/Thumbnail.astro'
import { cn } from '@/lib/utils/cn'
import { formatDateHuman, formatDateMachine } from '@/lib/utils/date'

const MAX_VISIBLE_TAGS = 2

type Props = {
  title: string
  description: string
  targetUrl: string
  createdAt: Date
  slug: string
  tags?: string[]
}

const { title, description, targetUrl, createdAt, slug, tags } = Astro.props

const visibleTags = tags?.slice(0, MAX_VISIBLE_TAGS)
const hasTags = !!visibleTags && visibleTags.length > 0
---

<article
  class={cn(
    'border-base-content/15 group bg-base-100 relative flex h-full flex-col overflow-hidden rounded-xl border transition-colors duration-200 ease-out',
    'hover:border-base-content/25 has-[a:focus-visible]:border-base-content/25',
    'has-[a:focus-visible]:outline-primary has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2',
  )}
>
  <div class="aspect-og relative overflow-hidden">
    <Thumbnail collection="blog" slug={slug} class="lg:max-w-90" />
  </div>
  <div class="flex grow flex-col p-4">
    <div class="mb-3 flex items-start justify-between gap-3">
      <time
        class="text-base-content/75 text-xs text-nowrap"
        datetime={formatDateMachine(createdAt)}>{formatDateHuman(createdAt)}</time
      >
      {
        hasTags && (
          <div class="flex flex-wrap gap-1.5">
            {visibleTags.map((tag) => (
              <span class="badge badge-accent dark:badge-soft badge-sm">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
    <h3 class="mb-3 line-clamp-2 text-lg font-bold">
      <a href={targetUrl} class="link-overlay">{title}</a>
    </h3>
    <p class="text-base-content/75 mb-3 line-clamp-3">{description}</p>
    <span class="mt-auto inline-flex items-center gap-1"
      >Read more<Icon
        name="lucide:arrow-right"
        class="ease-springy size-4 transition-transform duration-300 motion-safe:group-hover:translate-x-1.25 motion-safe:group-has-[a:focus-visible]:translate-x-1.25"
      /></span
    >
  </div>
</article>
