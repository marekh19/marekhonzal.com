---
import { ROUTES } from '@/config/routes'
import type { Project } from '@/lib/types'

import ContentGrid from './ContentGrid/ContentGrid.astro'
import ProjectCard from './ProjectCard.astro'

type Props = {
  projects: readonly Project[]
  className?: string
  isAboveFold?: boolean
}

const { projects, className } = Astro.props
---

<ContentGrid type="project" className={className}>
  {
    projects.map((project) => (
      <ProjectCard
        title={project.data.title}
        description={project.data.description}
        targetUrl={ROUTES.projects.detail(project.id)}
        createdAt={project.data.createdAt}
        slug={project.id}
        gitHubUrl={project.data.githubUrl}
      />
    ))
  }
</ContentGrid>
