# All
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' data: https://giscus.app https://a7s.hnzl.dev https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://giscus.app; font-src 'self' data:; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; connect-src 'self' https://a7s.hnzl.dev; frame-src https://giscus.app; frame-ancestors 'none'; upgrade-insecure-requests;
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=(), web-share=(), xr-spatial-tracking=(), screen-wake-lock=(), clipboard-write=(self), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin

# HTML routes, feeds and sitemaps use Workers Static Assets' default:
# Cache-Control: public, max-age=0, must-revalidate. Cloudflare caches assets automatically.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Content-hashed assets stay fresh for 2 years without revalidation.

/_astro/*
  Cache-Control: public, max-age=63072000, immutable

# Fonts are versioned in the filename (lora-v36, open-sans-v43), not
# content-hashed. 2 years is fine as long as we never edit a file in place.
/fonts/*
  Cache-Control: public, max-age=63072000, immutable

# Rarely changing, unhashed assets

# 604800 = 7 days
/videos/*
  Cache-Control: public, max-age=604800

# 86400 = 1 day
/favicon/*
  Cache-Control: public, max-age=86400

# 86400 = 1 day; OG images are rebuilt from posts on deploy
/og/*
  Cache-Control: public, max-age=86400

# 86400 = 1 day
/robots.txt
  Cache-Control: public, max-age=86400
